<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this theme only sets the window background behind it. -->
    <style name="Theme.DoubleEntry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DoubleEntry.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DoubleEntry</item>
    </style>
</resources>
